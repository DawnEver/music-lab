{
  "name": "music-lab",
  "version": "2.0.0",
  "description": "Music Lab — browser-based tuning, pitch and chord analysis, and a professional metronome. Vue 3 + Vuetify, fully client-side.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "pitch-detection",
    "chord-recognition",
    "tuner",
    "guitar-tuner",
    "harmonica",
    "guzheng",
    "guqin",
    "yin",
    "web-audio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://music.mingyangbao.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DawnEver/music-lab.git"
  },
  "bugs": {
    "url": "https://github.com/DawnEver/music-lab/issues"
  }
}
