{
  "name": "music-lab",
  "version": "2.7.0",
  "description": "Music Lab — browser-based tuning, a time-frequency scope, a professional metronome, and ear training with sight-singing. Vue 3 + Vuetify, fully client-side.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "pitch-detection",
    "chord-recognition",
    "tuner",
    "guitar-tuner",
    "harmonica",
    "guzheng",
    "guqin",
    "yin",
    "web-audio",
    "spectrogram",
    "ear-training",
    "sight-singing",
    "solfege"
  ],
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vuetify": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://music.mingyangbao.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DawnEver/music-lab.git"
  },
  "bugs": {
    "url": "https://github.com/DawnEver/music-lab/issues"
  }
}
